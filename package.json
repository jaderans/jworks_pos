{
  "name": "jworks-pos",
  "private": true,
  "version": "0.1.0",
  "description": "JoshWorks POS: offline-first event register, production cost, profit share, reports and pricing calculator.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test e2e/smoke.spec.ts e2e/dryrun.spec.ts e2e/tour.spec.ts e2e/layout.spec.ts e2e/owner.spec.ts",
    "e2e:cloud": "playwright test e2e/cloud.spec.ts",
    "emulators": "npx --yes firebase-tools emulators:start --only auth,firestore --project demo-jwpos",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.19.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.48.0",
    "pdfmake": "^0.3.11",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1"
  }
}
